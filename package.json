{
  "name": "uenroll",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "author": "Raman Gupta",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "eslint": "^10.3.0",
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter @repo/db --filter @repo/env --filter @repo/ui",
    "check-types": "turbo run check-types",
    "ci:format": "oxfmt --check",
    "db:down": "docker compose -f ./packages/db/docker-compose.yml down",
    "db:migrate": "turbo run --filter @repo/db db:migrate",
    "db:seed": "turbo run --filter @repo/db db:seed",
    "db:studio": "turbo run --filter @repo/db db:studio",
    "db:up": "docker compose -f ./packages/db/docker-compose.yml up -d && bun run db:migrate",
    "dev:scraper": "turbo run --filter uenroll-scraper dev",
    "dev:web": "turbo run --filter web dev",
    "format": "oxfmt --write",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "eslint": "catalog:",
    "oxfmt": "^0.48.0",
    "tsup": "^8.5.0",
    "turbo": "^2.9.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.2"
}
