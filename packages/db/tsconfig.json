{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Base Options
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    // Strictness
    "noImplicitOverride": true,
    // Transpiling with TypeScript
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"]
}
