{
  "name": "web",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:wasm": "cd ./generator/ && wasm-pack build --target web --release --out-dir ../public/wasm && rm -rf ../public/wasm/.gitignore",
    "check-types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev",
    "lint": "eslint --max-warnings 0 .",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "lz-string": "^1.5.0",
    "minisearch": "^7.1.2",
    "moment": "^2.30.1",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "posthog-js": "^1.372.10",
    "posthog-node": "^5.33.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rrule": "^2.8.1",
    "sonner": "^2.0.6",
    "temporal-polyfill": "^0.3.2",
    "ts-ics": "^2.4.4",
    "vite": "^8.0.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "catalog:",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:",
    "wrangler": "^4.90.0"
  }
}
