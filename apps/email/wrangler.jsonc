{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uenroll-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "send_email": [
    {
      "name": "SUPPORT_EMAIL",
      "destination_address": "support@uenroll.ca",
    },
  ],
}
